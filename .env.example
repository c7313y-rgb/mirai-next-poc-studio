# ===== 副担任mirAI NEXT PoC 設定 =====
PORT=3000
# 本番では必ず https のURLを設定（QRコードのログインURLに使用）
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=true
DATA_DIR=./data

# 仮名ID生成用シークレット（32文字以上のランダム文字列。実証期間中は絶対に変更しない）
PSEUDO_ID_SECRET=change-me-to-a-long-random-string
# 撮影画像のアプリ層暗号化キー（base64の32バイト。未設定なら暗号化しない→本番では必須）
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ===== AI =====
# mock | bedrock | anthropic
#   mock      : 外部送信なしのデモ用（読み取りはダミー、タグ・アラートはキーワード判定）
#   bedrock   : 国内処理を実契約・推論プロファイルで確認して使用
#   anthropic : Claude API 直接（国内リージョン要件を満たさないため検証用途のみ）
AI_PROVIDER=mock
# 本番Bedrockでは、処理地域・保存・学習利用条件の確認記録を残してからtrueにする
# この設定だけで国内処理を保証するものではありません
AI_DOMESTIC_PROCESSING_CONFIRMED=false
AI_CONCURRENCY=4
# 実AIの月間送信試行数（JST月単位、失敗・worker再試行も加算、mock除外、0で停止）
# 金額上限ではありません。初月AI予算1万円はAWS側の課金通知と実績確認も併用してください。
AI_MONTHLY_REQUEST_LIMIT=3000
# プロンプト全体（指示文を含む）の上限。1〜24000文字で設定します。
AI_MAX_INPUT_CHARS=24000
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_OCR=jp.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_TEXT=jp.anthropic.claude-haiku-4-5-20251001-v1:0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OCR=claude-sonnet-5
ANTHROPIC_MODEL_TEXT=claude-haiku-4-5-20251001

# 副担任mirAI連携データの仮名IDモード: hmac（推奨）| plain（学校コード-学年-組-番号をそのまま）
EXPORT_ID_MODE=hmac

# バックアップ全体の暗号化。画像鍵とは別の32バイトbase64を使用。
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# 既知のリバースプロキシ数。直接接続は0、Compose+Caddyは1。
TRUST_PROXY_HOPS=0

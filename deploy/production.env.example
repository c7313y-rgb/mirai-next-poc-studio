# Copy to .env.production; keep the real file outside Git.
NODE_ENV=production
DEMO_MODE=false
PUBLIC_BASE_URL=https://your-school-domain.example
DATA_DIR=/app/data
PSEUDO_ID_SECRET=
DATA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/app/backups
BACKUP_KEEP_DAYS=14
AI_PROVIDER=bedrock
# Set true only after checking the selected model, processing region and retention terms.
AI_DOMESTIC_PROCESSING_CONFIRMED=false
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_OCR=jp.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_TEXT=jp.anthropic.claude-haiku-4-5-20251001-v1:0
AI_CONCURRENCY=2
AI_MONTHLY_REQUEST_LIMIT=3000
AI_MAX_INPUT_CHARS=24000
TRUST_PROXY_HOPS=1
EXPORT_ID_MODE=hmac

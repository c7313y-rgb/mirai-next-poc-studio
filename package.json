{
  "name": "mirai-next-poc-studio",
  "version": "0.4.1",
  "private": true,
  "description": "企業の知見を授業へ、学びをキャリアへつなぐ副担任mirAI NEXT PoC",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix client ci",
    "build": "node scripts/build.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "local:start": "node scripts/local-demo.mjs start",
    "local:status": "node scripts/local-demo.mjs status",
    "local:stop": "node scripts/local-demo.mjs stop",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "purge": "node --disable-warning=ExperimentalWarning scripts/purge.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "demo": "node scripts/demo.js",
    "seed:learning": "node --disable-warning=ExperimentalWarning scripts/seed-learning.js",
    "restore-check": "node --disable-warning=ExperimentalWarning scripts/restore-check.js",
    "production-check": "node --disable-warning=ExperimentalWarning scripts/production-check.js",
    "seed:journey": "node --disable-warning=ExperimentalWarning scripts/seed-journey.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "license": "UNLICENSED"
}
